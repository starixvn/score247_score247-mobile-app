<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LiveScore.Features.Menu.Views.PrivacyAndCookiesView"
             xmlns:viewModel="clr-namespace:LiveScore.Features.Menu.ViewModels"
             xmlns:languages="clr-namespace:LiveScore.Common.LangResources;assembly=LiveScore.Common"
             xmlns:prism="clr-namespace:Prism.Mvvm;assembly=Prism.Forms"
             xmlns:viewResources="clr-namespace:LiveScore.Features.Menu.ViewResources"
             prism:ViewModelLocator.AutowireViewModel="True"
             x:DataType="viewModel:PrivacyAndCookiesViewModel"
             BackgroundColor="{StaticResource SiteBackgroundColor}">
    <NavigationPage.TitleView>
        <Label Text="{languages:Translate PrivacyAndCookies}" Style="{StaticResource MenuTitle}" />
    </NavigationPage.TitleView>
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding DoneCommand}"
                     Order="Primary"
                     Priority="1"
                     Text="Done" />
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <viewResources:MenuResource />
                <viewResources:PrivacyAndCookiesViewResource />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <ScrollView Orientation="Vertical">
            <StackLayout>
                <Label Style="{StaticResource CookiesPolicy}" Text="{languages:Translate CookiesPolicyScore247}" />
                <StackLayout Style="{StaticResource PrivacySection}">
                    <Label  Style="{StaticResource PrivacyContent}" Text="{languages:Translate CookiesPolicyScore247Intro}" />
                    <Label Style="{StaticResource PrivacyGroupTitle}" Text="{languages:Translate HowWeUseCookies}" />
                    <Label Style="{StaticResource PrivacyContent}" Text='{languages:Translate HowWeUseCookiesIntro}' />

                    <Label Style="{StaticResource PrivacyGroupTitle}" Text="{languages:Translate DisablingCookies}" />
                    <Label Style="{StaticResource PrivacyContent}" Text='{languages:Translate DisablingCookiesIntro}' />

                    <Label Style="{StaticResource PrivacyGroupTitle}" Text="{languages:Translate WhatPersonalInformationWeCollect}" />
                    <Label Style="{StaticResource PrivacyContent}" Text='{languages:Translate WhatPersonalInformationWeCollectIntro}' />

                    <Label Style="{StaticResource PrivacyGroupTitle}" Text="{languages:Translate HowWeUseYourInformation}" />
                    <Label Style="{StaticResource PrivacyContent}" Text='{languages:Translate HowWeUseYourInformationIntro1}' />

                    <Label  Style="{StaticResource PrivacyList}" Text="{languages:Translate HowWeUseYourInformationIntro2}" />
                </StackLayout>
                <Label Style="{StaticResource CookiesPolicy}" Text="{languages:Translate AccessAndCorrection}" />
                <StackLayout Style="{StaticResource PrivacySection}">
                    <Label Style="{StaticResource PrivacyContent}" Text="{languages:Translate AccessAndCorrectionIntro}" />
                    <Label Style="{StaticResource PrivacyGroupTitle}" Text="{languages:Translate HowSecureIsYourInformation}" />
                    <Label Style="{StaticResource PrivacyContent}" Text="{languages:Translate HowSecureIsYourInformationIntro}" />
                </StackLayout>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>