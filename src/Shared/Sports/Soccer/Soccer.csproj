    </Compile>
    <Compile Update="Views\Matches\Templates\MatchDetails\TrackerCommentary\TrackerCommentaryTemplate.xaml.cs">
      <DependentUpon>TrackerCommentaryTemplate.xaml</DependentUpon>
    </Compile>
   

  </ItemGroup>
