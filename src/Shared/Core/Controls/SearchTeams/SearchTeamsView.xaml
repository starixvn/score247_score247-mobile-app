<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:prism="clr-namespace:Prism.Mvvm;assembly=Prism.Forms"
             xmlns:ffloading="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
             xmlns:customSearchBar="clr-namespace:LiveScore.Core.Controls.CustomSearchBar;assembly=LiveScore.Core"
             xmlns:coreResources="clr-namespace:LiveScore.Core.ViewResources;assembly=LiveScore.Core"
             xmlns:converters="clr-namespace:LiveScore.Common.Converters;assembly=LiveScore.Common"
             xmlns:xamanimation="clr-namespace:Xamanimation;assembly=Xamanimation"
             xmlns:xamEffects="clr-namespace:XamEffects;assembly=XamEffects"
             prism:ViewModelLocator.AutowireViewModel="True"
             x:Name="self"
             x:Class="LiveScore.Core.Controls.SearchTeams.SearchTeamsView"
             BackgroundColor="{StaticResource SiteBackgroundColor}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <coreResources:MatchHeaderViewResource />
            </ResourceDictionary.MergedDictionaries>
            <converters:UpperCaseConverter x:Key="UpperCaseConverter" />
            <converters:ReverseBoolConverter x:Key="ReverseBoolConverter" />
            <xamanimation:StoryBoard  x:Key="SearchViewFadeInAnimation"
                                      Target="{x:Reference SearchView}">
                <xamanimation:FadeToAnimation Easing="Linear"
                                              Opacity="1"
                                              Duration="250" />
            </xamanimation:StoryBoard>

            <xamanimation:StoryBoard  x:Key="SearchBarControlFadeInAnimation"
                                      Target="{x:Reference SearchBarControl}">
                <xamanimation:FadeToAnimation Easing="Linear"
                                              Opacity="1"
                                              Duration="250" />
            </xamanimation:StoryBoard>
        </ResourceDictionary>
    </ContentPage.Resources>
    <NavigationPage.TitleView>
        <customSearchBar:SearchBarTemplate x:Name="SearchBarControl"
                                           Opacity="0"
                                           PlaceHolderText="Search teams"
                                           SearchCommand="{Binding SearchTeamCommand}"
                                           CancelCommand="{Binding CancelSearchCommand}" />
    </NavigationPage.TitleView>
    <ContentPage.Triggers>
        <EventTrigger Event="Appearing">
            <xamanimation:BeginAnimation Animation="{StaticResource SearchViewFadeInAnimation}" />
            <xamanimation:BeginAnimation Animation="{StaticResource SearchBarControlFadeInAnimation}" />
        </EventTrigger>
    </ContentPage.Triggers>
    <ContentPage.Content>
        <StackLayout Opacity="0"
                     x:Name="SearchView">
            <ListView Style="{StaticResource ListViewHasBackground}"
                      ItemsSource="{Binding DefaultSearch}"
                      IsVisible="{Binding ShowTrendingHeader}"
                      Scrolled="ListView_OnScrolled"
                      HasUnevenRows="True"
                      IsGroupingEnabled="True"
                      SeparatorVisibility="None">
                <ListView.GroupHeaderTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <StackLayout>
                                <BoxView Grid.Row="0"
                                 Style="{StaticResource HeaderBarLine}" />
                                <Grid Style="{StaticResource LeagueBox}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{StaticResource FunctionGroupHeight}" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Text="{Binding Heading, Converter={StaticResource UpperCaseConverter}}"
                                       Padding="16,0,0,0"
                                       Style="{StaticResource LeagueName}">
                                    </Label>
                                </Grid>
                                <BoxView Style="{StaticResource HorizontalLine}" />
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.GroupHeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{StaticResource FunctionGroupHeight}" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <StackLayout Grid.Row="0"
                                             Grid.Column="0"
                                             Orientation="Horizontal"
                                             xamEffects:Commands.Tap="{Binding Path=BindingContext.OpenTeamDetailCommand, Source={x:Reference Name=self}}"
                                             xamEffects:Commands.TapParameter="{Binding .}">
                                    <ffloading:CachedImage
                                                       Source="{Binding LogoUrl}"
                                                       DownsampleToViewSize="True"
                                                       WidthRequest="60"
                                                       HorizontalOptions="Start"
                                                       ErrorPlaceholder="images/common/default_soccer_team.png"
                                                       Style="{StaticResource CountryFlag}" />
                                    <Label
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="CenterAndExpand"
                                       Style="{StaticResource LeagueName}"
                                       Text="{ Binding Name, Converter={StaticResource UpperCaseConverter }}" />
                                </StackLayout>

                                <Button Grid.Row="0"
                                        Grid.Column="1"
                                        Command="{Binding Path=BindingContext.FavoriteCommand, Source={x:Reference Name=self}}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource InActiveFavoriteIcon}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button"
                                                     Binding="{Binding IsFavorite}"
                                                     Value="True">
                                            <Setter Property="Style"
                                                    Value="{StaticResource ActiveFavoriteIcon}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>

                                <BoxView Grid.Row="1"
                                         Grid.Column="0"
                                         Grid.ColumnSpan="2"
                                         Style="{StaticResource HorizontalLine}" />
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ListView Style="{StaticResource ListViewHasBackground}"
                      ItemsSource="{Binding TeamsItemSource}"
                      HasUnevenRows="True"
                      IsVisible="{Binding ShowTrendingHeader, Converter={StaticResource ReverseBoolConverter }}"
                      Scrolled="ListView_OnScrolled"
                      SeparatorVisibility="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{StaticResource FunctionGroupHeight}" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <StackLayout Grid.Row="0"
                                             Grid.Column="0"
                                             Orientation="Horizontal"
                                             xamEffects:Commands.Tap="{Binding Path=BindingContext.OpenTeamDetailCommand, Source={x:Reference Name=self}}"
                                             xamEffects:Commands.TapParameter="{Binding .}">
                                    <ffloading:CachedImage
                                                       Source="{Binding LogoUrl}"
                                                       DownsampleToViewSize="True"
                                                       WidthRequest="60"
                                                       HorizontalOptions="Start"
                                                       ErrorPlaceholder="images/common/default_soccer_team.png"
                                                       Style="{StaticResource CountryFlag}" />
                                    <Label
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="CenterAndExpand"
                                       Style="{StaticResource LeagueName}"
                                       Text="{ Binding Name, Converter={StaticResource UpperCaseConverter }}" />
                                </StackLayout>

                                <Button Grid.Row="0"
                                        Grid.Column="1"
                                        Command="{Binding Path=BindingContext.FavoriteCommand, Source={x:Reference Name=self}}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource InActiveFavoriteIcon}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button"
                                                     Binding="{Binding IsFavorite}"
                                                     Value="True">
                                            <Setter Property="Style"
                                                    Value="{StaticResource ActiveFavoriteIcon}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>

                                <BoxView Grid.Row="1"
                                         Grid.Column="0"
                                         Grid.ColumnSpan="2"
                                         Style="{StaticResource HorizontalLine}" />
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>